# ============================================================
# QiaoMES 环境变量模板
#
# 用法：
#   cp .env.example .env      # 本地 docker compose up -d --build 会自动读取 .env
#   服务器：写到 /root/qiaomes/.env（CI 部署时**合并写入**，只覆盖本次显式提供的键）
#
# 🔴 三条硬规则：
#   1. **必须先有 .env 再 `up -d`**，否则 WEB_PORT 退回 8080、POSTGRES_PASSWORD 退回默认值。
#   2. `POSTGRES_PASSWORD` 在**数据库卷首次初始化时**就写死了 —— 事后改这里不会改库里的密码，
#      只会让 API 连不上库（除非同步改库）。改名前请先 `pg_dump`。
#   3. 本文件里的值都是占位符，**生产务必替换**；`.env` 已在 `.gitignore` 里，不要把它提交上去。
#
# 变量名 -> 容器内配置键的对应关系：`__` 是 ASP.NET Core 的层级分隔符，
#   例：Iteration__BaseUrl  ==  appsettings.json 里的 { "Iteration": { "BaseUrl": ... } }
# ============================================================

# ---------------- 镜像（方式②③：服务器只拉不构建）----------------
# 完整镜像地址（含 registry 与 tag）。留空则用 compose 里的默认值（腾讯 TCR）。
QIAOMES_API_IMAGE=ccr.ccs.tencentyun.com/qiaoqiao11/qiaomes-api:latest
QIAOMES_WEB_IMAGE=ccr.ccs.tencentyun.com/qiaoqiao11/qiaomes-web:latest

# ---------------- 基础 ----------------
# JWT 签名密钥，**至少 32 字符**；改了会让所有人重新登录
JWT_SECRET_KEY=Change_Me_At_Least_32_Chars_0123456789abcdef
# ⚠️ 必须与数据库卷初始化时一致，不确定就别填（留空 = 用 compose 默认值）
POSTGRES_PASSWORD=
# 数据库端口绑到哪个宿主地址。**服务器保持默认**（不写 = 127.0.0.1，只回环，不对公网开放）。
# 只有「在本机（Docker Desktop）跑这份编排、且需要从 Windows 直连数据库」时才有必要写 0.0.0.0 ——
# Docker Desktop 只代理 0.0.0.0 的端口映射，绑 127.0.0.1 宿主连不上。
# POSTGRES_BIND=0.0.0.0
# 前端对外端口（本机与看板站共存故用 8090；本地开发用 8080）
WEB_PORT=8090
# 允许的跨域来源，多个用逗号分隔
CORS_ORIGINS=https://mes.qiaoqiaoqiao.me,http://139.196.195.44:8090
# 看板站 Caddy 的网关网络名（external，用于域名反代 qiaomes-web:80）
GATEWAY_NETWORK=kanban_net

# ---------------- 演示数据 ----------------
# true 才会放行 /api/dev/demo-data（先用它，再跑 tools/seed-demo.ps1）
DEMO_DATA_ENABLED=false

# ---------------- 智能问数（AI + 数据库）--------------
# 详细说明见 docs/AI-QUERY.md。也可以登录后在「智能问数」页直接配（保存即生效，优先于这里）
ASSISTANT_ENABLED=true
ASSISTANT_LLM_BASE_URL=https://api.deepseek.com/v1
ASSISTANT_LLM_MODEL=deepseek-chat
ASSISTANT_LLM_API_KEY=
# 生产建议指向独立只读账号；留空则复用主连接（靠 READ ONLY 事务兜底）
ASSISTANT_DB_CONNECTION=

# ---------------- 改进建议 / AI 迭代服务 ----------------
# 详细说明见 docs/ITERATION.md。**两个都留空 = 该功能关闭**（页面显示「迭代服务还没配置」，不会报错）
# BaseUrl 填迭代服务的地址：与 QiaoMES 同在容器网络里就用服务名，如 http://ai-iteration:8080
ITERATION_BASE_URL=
# 必须与迭代服务端的 Admin__ApiKey 完全一致（宿主服务端代持，不下发浏览器）
ITERATION_ADMIN_KEY=
