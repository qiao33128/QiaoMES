<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\QiaoMES.Assistant.Application.csproj" />
    <ProjectReference Include="..\Domain\QiaoMES.Assistant.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Infrastructure\QiaoMES.Infrastructure\QiaoMES.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\Shared\QiaoMES.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 已经带上底层 Npgsql 驱动（只读执行器直接用 NpgsqlConnection） -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

</Project>
